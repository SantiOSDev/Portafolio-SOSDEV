# Servidor SMTP
SMTP_HOST=smtp.su-proveedor.com
SMTP_PORT=587
SMTP_SECURE=false

# Autenticación SMTP. Use una contraseña de aplicación o token cuando el proveedor lo requiera.
SMTP_USER=usuario_smtp
SMTP_PASS=reemplace_con_una_clave_segura

# Remitente autorizado por el servidor y buzón que recibirá los formularios.
SMTP_FROM="SOSDEV Web <contacto@sosdev.com.co>"
CONTACT_TO=contacto@sosdev.com.co

# Opcional: orígenes adicionales autorizados para el formulario (separados por comas).
# CONTACT_ALLOWED_ORIGINS=https://staging.sosdev.com.co
